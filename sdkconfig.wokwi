#
# Wokwi-specific overrides for ESP32-S3 simulation
# Generated from sdkconfig.defaults + overrides
#
CONFIG_IDF_TARGET="esp32s3"
CONFIG_SOC_ADC_SUPPORTED=y
CONFIG_SOC_ADC_DIG_CTRL_SUPPORTED=y

# TinyUSB - keep enabled for USB MIDI testing
CONFIG_TINYUSB=y
CONFIG_TINYUSB_MIDI_COUNT=1
CONFIG_TINYUSB_DEBUG_LEVEL=3

# USB OTG
CONFIG_USB_OTG_SUPPORTED=y

# Console on UART (Wokwi serial monitor)
CONFIG_ESP_CONSOLE_UART=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_UNICORE=n

# Disable PSRAM for Wokwi (causes boot issues)
CONFIG_ESP32S3_SPIRAM_SUPPORT=n
# CONFIG_SPIRAM is not set

# Disable ADC continuous ISR IRAM safe (Wokwi)
CONFIG_ADC_CONTINUOUS_ISR_IRAM_SAFE=n

# NVS
CONFIG_NVS_ENCRYPTION=n

# Compiler optimizations
CONFIG_COMPILER_OPTIMIZATION_PERF=y
